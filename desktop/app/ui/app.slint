// DroidPods companion window: sidebar plus one page at a time.

import { Theme, Icons } from "theme.slint";
import { Icon, NavItem, WinButton } from "widgets.slint";
import {
    AccessibilityPage, AppPage, Bat, ControlsPage, Dev, DevicePage, DisconnectedPage, Known, OverviewPage,
    Prefs, SoundPage,
} from "pages.slint";

export { Theme, Dev, Prefs, Bat, Known }

export component AppWindow inherits Window {
    title: "DroidPods";
    no-frame: true;
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 760px;
    min-height: 520px;
    background: Theme.win;
    default-font-size: 13px;

    // 0 overview, 1 sound, 2 controls, 3 accessibility, 4 AirPods, 5 app
    in-out property <int> page: 0;
    // Set from a change handler rather than bound to width, which would loop through the layout.
    property <bool> narrow: false;
    changed width => { self.narrow = self.width < 920px; }

    callback start-drag();
    callback minimize();
    callback close-window();

    // Without AirPods only the App page is reachable.
    property <int> shown: Dev.connected || page == 5 ? page : -1;

    HorizontalLayout {
        // ---------------------------------------------------------- rail
        Rectangle {
            width: 232px;
            background: Theme.rail;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            // Only the title strip moves the window, like the main area's top bar.
            TouchArea {
                y: 0px;
                height: 44px;
                pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-drag(); } }
            }
            VerticalLayout {
                padding: 10px;
                padding-top: 14px;
                spacing: 2px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-bottom: 14px;
                    padding-top: 4px;
                    spacing: 8px;
                    Rectangle {
                        width: 22px; height: 22px; border-radius: 7px; background: Theme.accent;
                        Icon { width: 14px; height: 14px; color: white; commands: Icons.pods; }
                    }
                    Text { text: "DroidPods"; color: Theme.text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                }
                Rectangle {
                    border-radius: 14px;
                    background: Theme.card;
                    HorizontalLayout {
                        padding: 10px;
                        spacing: 10px;
                        Rectangle {
                            width: 36px; height: 36px; border-radius: 10px; background: Theme.card2;
                            Icon {
                                width: 22px; height: 22px;
                                color: Dev.connected ? Theme.text : Theme.dim;
                                commands: Dev.headphones ? Icons.headphones : Icons.pods;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Text { text: Dev.connected ? Dev.name : "Nicht verbunden"; color: Theme.text; font-size: 12.5px; font-weight: 600; overflow: elide; }
                            Text {
                                text: Dev.connected ? Dev.status-line : Prefs.last-device != "" ? "Zuletzt: " + Prefs.last-device : "Suche nach AirPods…";
                                color: Theme.dim;
                                font-size: 11px;
                                font-family: Dev.connected ? Theme.mono : "";
                                overflow: elide;
                            }
                        }
                    }
                }
                Rectangle { height: 12px; }
                NavItem { label: "Übersicht"; icon: Icons.home; active: root.shown == 0; enabled: Dev.connected; clicked => { root.page = 0; } }
                NavItem { label: "Klang"; icon: Icons.sound; active: root.shown == 1; enabled: Dev.connected; clicked => { root.page = 1; } }
                NavItem { label: "Steuerung"; icon: Icons.hand; active: root.shown == 2; enabled: Dev.connected; clicked => { root.page = 2; } }
                NavItem { label: "Bedienungshilfen"; icon: Icons.access; active: root.shown == 3; enabled: Dev.connected; clicked => { root.page = 3; } }
                NavItem {
                    label: "AirPods";
                    icon: Dev.headphones ? Icons.headphones : Icons.pods;
                    active: root.shown == 4;
                    enabled: Dev.connected;
                    clicked => { root.page = 4; }
                }
                Rectangle { vertical-stretch: 1; }
                NavItem { label: "App"; icon: Icons.gear; active: root.shown == 5; clicked => { root.page = 5; } }
            }
        }

        // ---------------------------------------------------------- main
        VerticalLayout {
            horizontal-stretch: 1;
            Rectangle {
                height: 44px;
                TouchArea {
                    pointer-event(e) => { if e.kind == PointerEventKind.down && e.button == PointerEventButton.left { root.start-drag(); } }
                }
                HorizontalLayout {
                    padding-right: 8px;
                    spacing: 2px;
                    alignment: end;
                    VerticalLayout { alignment: center; WinButton { icon: Icons.min; clicked => { root.minimize(); } } }
                    VerticalLayout { alignment: center; WinButton { icon: Icons.x; clicked => { root.close-window(); } } }
                }
            }
            Flickable {
                vertical-stretch: 1;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    width: min(parent.width, 740px);
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-bottom: 40px;
                    if root.shown == -1: DisconnectedPage { }
                    if root.shown == 0: OverviewPage { narrow: root.narrow; }
                    if root.shown == 1: SoundPage { narrow: root.narrow; }
                    if root.shown == 2: ControlsPage { }
                    if root.shown == 3: AccessibilityPage { }
                    if root.shown == 4: DevicePage { }
                    if root.shown == 5: AppPage { }
                }
            }
        }
    }
}
