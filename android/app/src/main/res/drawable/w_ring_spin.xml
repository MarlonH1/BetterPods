<?xml version="1.0" encoding="utf-8"?>
<!-- Indeterminate ring for the "connecting" state: a comet tail sweeping over the track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="10" android:useLevel="false">
            <solid android:color="@color/widget_surface_highest" />
        </shape>
    </item>
    <item>
        <rotate android:fromDegrees="0" android:toDegrees="1080" android:pivotX="50%" android:pivotY="50%">
            <shape android:shape="ring" android:innerRadiusRatio="2.6" android:thicknessRatio="10" android:useLevel="false">
                <gradient android:type="sweep" android:startColor="#00FFFFFF" android:endColor="@color/widget_primary" />
            </shape>
        </rotate>
    </item>
</layer-list>
