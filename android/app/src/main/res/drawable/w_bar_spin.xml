<?xml version="1.0" encoding="utf-8"?>
<!-- Small indeterminate spinner for pills and strips. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0" android:toDegrees="1080" android:pivotX="50%" android:pivotY="50%">
    <shape android:shape="ring" android:innerRadiusRatio="3" android:thicknessRatio="9" android:useLevel="false">
        <gradient android:type="sweep" android:startColor="#00FFFFFF" android:endColor="@color/widget_primary" />
    </shape>
</rotate>
